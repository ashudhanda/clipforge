# ClipForge is open source — NEVER commit secrets.
# OAuth client JSON / tokens live in ~/.clipforge/ (outside this repo) by design.
youtube_client.json
youtube_token.json
quota.json
*.token.json
*client_secret*.json

# Local config / runtime state
.clipforge/
config.json
*.log

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local media (large, machine-specific) — EXCEPT the 9 caption-style preview
# clips shipped with the app (dashboard needs them; PyInstaller bundles them)
previews/*
!previews/style_preview_*.mp4
clips/
downloads/
*.mp4
!previews/style_preview_*.mp4
*.mkv
*.webm
!tests/fixtures/**

# OS / editor
.DS_Store
.idea/
.vscode/

# build-time FFmpeg binaries (downloaded by fetch-ffmpeg.* in CI)
packaging/bin/
